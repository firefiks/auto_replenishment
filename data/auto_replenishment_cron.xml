<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Daily demand analysis + Discuss report -->
        <record forcecreate="True" id="ir_cron_auto_replenishment_daily" model="ir.cron">
            <field name="name">Auto Replenishment: Daily Demand Analysis</field>
            <field name="model_id" ref="model_auto_replenishment_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_analysis_and_report()</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

    </data>
</odoo>