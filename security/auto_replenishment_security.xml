<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_auto_replenishment" model="ir.module.category">
            <field name="name">Auto Replenishment</field>
            <field name="description">Read/analyse queries for the Auto Replenishment feature.</field>
            <field name="sequence">40</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_auto_replenishment">
            <field name="name">Auto Replenishment</field>
            <field name="category_id" ref="module_category_auto_replenishment"/>
        </record>

        <record id="group_auto_replenishment_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_auto_replenishment"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">View auto replenishment demand analyses.</field>
        </record>

        <record id="group_auto_replenishment_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_auto_replenishment"/>
            <field name="implied_ids" eval="[(4, ref('group_auto_replenishment_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Manage auto replenishment analyses and create draft RFQs.</field>
        </record>

    </data>
</odoo>